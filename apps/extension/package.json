{
  "name": "@memedrop/extension",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite build --watch",
    "build": "tsc && vite build",
    "validate:release-metadata": "node scripts/validate-release-metadata.mjs",
    "validate:release-package": "node scripts/validate-release-package.mjs",
    "validate:store-readiness": "node scripts/validate-store-readiness.mjs --file apps/extension/store-listing.example.json",
    "init:store-listing": "node scripts/init-store-listing.mjs",
    "build:release": "npm run validate:release-metadata && node scripts/validate-release-build.mjs --pre && tsc && vite build --mode release && node scripts/validate-release-build.mjs --post && npm run validate:release-metadata",
    "package:release": "node scripts/package-release.mjs",
    "test": "node --import tsx --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource/anton": "5.3.0",
    "@fontsource/inter": "5.3.0",
    "@memedrop/shared": "*",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.7.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/chrome": "^0.2.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.5",
    "typescript": "^7.0.2",
    "vite": "^8.2.0"
  }
}
