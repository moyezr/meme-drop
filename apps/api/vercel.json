{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "fastapi",
  "installCommand": "uv sync --frozen --no-dev",
  "buildCommand": "uv run memedrop-validate-production-env && uv run python -c \"from app import app\"",
  "functions": {
    "app.py": {
      "maxDuration": 60,
      "regions": ["sin1"]
    }
  },
  "regions": ["sin1"],
  "crons": [
    {
      "path": "/internal/cron/assets/cleanup",
      "schedule": "30 3 * * *"
    }
  ]
}
