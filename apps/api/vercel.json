{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "fastapi",
  "installCommand": "uv sync --frozen --no-dev",
  "buildCommand": "uv run python -c \"from app import app\"",
  "crons": [
    {
      "path": "/internal/cron/trends/refresh",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/internal/cron/assets/cleanup",
      "schedule": "30 3 * * *"
    }
  ]
}
