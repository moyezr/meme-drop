{
  "name": "@memedrop/web",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "contract-check": "node scripts/check-agent-contract.mjs",
    "config-check": "node scripts/validate-production-config.mjs",
    "build": "npm run contract-check && npm run config-check && next build",
    "test": "node --import tsx --test tests/*.test.mjs tests/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "jose": "6.2.10",
    "next": "^16.3.1",
    "next-auth": "5.0.0-beta.32",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "postcss": "8.5.26",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.12",
    "typescript": "^6.0.3"
  }
}
