{
  "name": "memedrop",
  "private": true,
  "packageManager": "npm@11.7.0",
  "engines": {
    "node": ">=22.12",
    "npm": ">=11"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "tools/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test:workspaces": "turbo run test",
    "test": "node --test tests/*.test.mjs && npm run test:workspaces",
    "dev:api": "npm run dev --workspace=@memedrop/api",
    "dev:backend": "npm run dev:api",
    "dev:extension": "npm run dev --workspace=@memedrop/extension",
    "dev:landing": "npm run dev --workspace=@memedrop/landing",
    "build:shared": "npm run build --workspace=@memedrop/shared",
    "build:backend": "npm run build --workspace=@memedrop/api",
    "build:extension": "npm run build --workspace=@memedrop/extension",
    "build:landing": "npm run build --workspace=@memedrop/landing",
    "build:extension:release": "npm run build:release --workspace=@memedrop/extension",
    "package:extension:release": "npm run package:release --workspace=@memedrop/extension",
    "test:api": "npm run test --workspace=@memedrop/api",
    "test:api:integration": "npm run test:integration --workspace=@memedrop/api",
    "lint:api": "npm run lint --workspace=@memedrop/api",
    "format:api": "npm run format --workspace=@memedrop/api",
    "catalog:export": "tsx scripts/export-meme-catalog.ts",
    "quality:static": "npm run typecheck && npm test && npm run lint && npm run build && npm run manifest:audit --workspace=@memedrop/template-tools",
    "quality:release-config": "VITE_API_BASE_URL=https://api.memedrop.example npm run build:extension:release",
    "quality:release-metadata": "npm run validate:release-metadata --workspace=@memedrop/extension",
    "quality:release-package": "VITE_API_BASE_URL=https://api.memedrop.example npm run validate:release-package --workspace=@memedrop/extension",
    "quality:store-readiness": "npm run validate:store-readiness --workspace=@memedrop/extension",
    "quality:api-process": "npm run build:backend && node scripts/smoke-api-process.mjs",
    "quality:backend-image": "docker build -f Dockerfile.backend -t memedrop-backend:local . && node scripts/smoke-backend-image.mjs",
    "quality:benchmark": "npm run eval:benchmark-audit --workspace=@memedrop/template-tools",
    "quality:dataset-plan": "npm run dataset:promotion-plan -- --fail-on-blocked",
    "quality:promotion": "npm run quality:static && npm run quality:api-process && npm run quality:benchmark && npm run quality:dataset-plan && npm run manifest:review-gate --workspace=@memedrop/template-tools && npm run manifest:coverage-gate --workspace=@memedrop/template-tools && npm run quality:release-metadata && npm run quality:store-readiness && npm run quality:release-config",
    "quality:production-env": "uv run --package memedrop-api memedrop-validate-production-env",
    "quality:security": "node scripts/security-audit.mjs",
    "quality:suggestions": "uv run --package memedrop-api pytest apps/api/tests/test_catalog.py apps/api/tests/test_context_analyzer.py apps/api/tests/test_meme_text.py apps/api/tests/test_openrouter.py apps/api/tests/test_suggestion_engine.py -q",
    "launch:status": "node scripts/launch-status.mjs",
    "store-listing:init": "npm run init:store-listing --workspace=@memedrop/extension --",
    "release:dry-run": "node scripts/release-candidate.mjs",
    "release:candidate": "node scripts/release-candidate.mjs --strict --with-suggestion-eval",
    "dataset:expansion-report": "npm run manifest:expansion-report --workspace=@memedrop/template-tools -- --out .memedrop/template-expansion-report.json",
    "dataset:qa-expansion": "npm run dataset:expansion-report && npm run manifest:qa:expansion --workspace=@memedrop/template-tools",
    "dataset:taste-review": "npm run manifest:taste-review --workspace=@memedrop/template-tools",
    "dataset:review-decisions:init": "npm run manifest:review-decisions:init --workspace=@memedrop/template-tools --",
    "dataset:promotion-plan": "npm run manifest:promotion-plan --workspace=@memedrop/template-tools -- --out .memedrop/template-promotion-plan.json",
    "dataset:benchmark-stubs": "npm run dataset:promotion-plan && npm run manifest:benchmark-stubs --workspace=@memedrop/template-tools -- --out .memedrop/suggestion-benchmark-stubs.json",
    "dataset:benchmark-import": "npm run eval:benchmark-import --workspace=@memedrop/template-tools --",
    "dataset:review-decisions": "npm run manifest:review-decisions --workspace=@memedrop/template-tools",
    "dataset:review-decisions:promotion": "npm run manifest:review-decisions:promotion --workspace=@memedrop/template-tools",
    "dataset:promote-reviewed": "npm run manifest:promote-reviewed --workspace=@memedrop/template-tools",
    "dataset:usage-feedback": "uv run --package memedrop-api memedrop-usage-feedback",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:init": "uv run --package memedrop-api memedrop-db-init",
    "db:seed": "uv run --package memedrop-api memedrop-db-seed",
    "db:seed-memes": "uv run --package memedrop-api memedrop-db-seed-memes",
    "db:migrate": "uv run --package memedrop-api alembic upgrade head"
  },
  "devDependencies": {
    "turbo": "2.10.8"
  }
}
