# Backend
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/memedrop
OPENROUTER_API_KEY=
OPENROUTER_SITE_URL=http://localhost:3001
OPENROUTER_APP_NAME=MemeDrop
OPENROUTER_MEME_MODEL=z-ai/glm-5.2
OPENROUTER_TEMPLATE_MODEL=qwen/qwen3.6-plus
MEMEDROP_CORS_ORIGINS=http://localhost:5173,http://localhost:3001
MEMEDROP_RATE_LIMIT_WINDOW_MS=60000
MEMEDROP_RATE_LIMIT_MAX=600
MEMEDROP_EXPENSIVE_RATE_LIMIT_WINDOW_MS=60000
MEMEDROP_EXPENSIVE_RATE_LIMIT_MAX=180
MEMEDROP_RATE_LIMIT_STORE=memory
MEMEDROP_REQUIRE_INSTALL_ID=false
MEMEDROP_CONTEXT_TIMEOUT_MS=15000
MEMEDROP_RERANK_TIMEOUT_MS=15000
MEMEDROP_CAPTION_TIMEOUT_MS=20000
MEMEDROP_USE_DRAFT_TEMPLATES=false
MEMEDROP_USE_CONTEXTUAL_CAPTION_FALLBACK=true
MEMEDROP_LOG_LEVEL=debug
MEMEDROP_SUGGESTION_LOGS=pretty
MEMEDROP_SUGGESTION_LOG_TEXT=preview
MEMEDROP_IMAGE_DOWNLOAD_TIMEOUT_MS=10000
MEMEDROP_MAX_IMAGE_BYTES=8388608
MEME_STORAGE_PATH=./data/memes

# Extension
VITE_API_BASE_URL=http://localhost:3001
# Chrome Web Store builds must set VITE_API_BASE_URL to the production HTTPS API origin.
# Example: VITE_API_BASE_URL=https://api.memedrop.example
