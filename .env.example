# Backend
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/memedrop
OPENROUTER_API_KEY=
OPENROUTER_SITE_URL=http://localhost:3001
OPENROUTER_APP_NAME=MemeDrop
OPENROUTER_SUGGESTION_MODEL=openai/gpt-5.4-mini
OPENROUTER_CAPTION_MODEL=openai/gpt-5.4-mini
OPENROUTER_AUTO_TAG_MODEL=qwen/qwen3.6-plus
# Used only by offline template-catalog generation tools, never by the API runtime.
OPENROUTER_TEMPLATE_MODEL=qwen/qwen3.6-plus
MEMEDROP_CORS_ORIGINS=http://localhost:5173,http://localhost:3001
MEMEDROP_RATE_LIMIT_WINDOW_MS=60000
MEMEDROP_RATE_LIMIT_MAX=600
MEMEDROP_EXPENSIVE_RATE_LIMIT_WINDOW_MS=60000
MEMEDROP_EXPENSIVE_RATE_LIMIT_MAX=180
MEMEDROP_RATE_LIMIT_STORE=redis
REDIS_URL=redis://localhost:6379/0
MEMEDROP_REQUIRE_INSTALL_ID=false
# The normal suggestion path makes one bounded joint selection-and-caption call.
MEMEDROP_JOINT_SUGGESTION_TIMEOUT_MS=4500
# OpenRouter preference for the joint request only. This prioritizes time-to-first-token while
# preferring providers that complete at p90 within the interactive suggestion budget. These are
# preferences: standard provider fallbacks remain enabled if no endpoint satisfies them.
MEMEDROP_JOINT_PROVIDER_SORT=latency
MEMEDROP_JOINT_PROVIDER_P90_MAX_LATENCY_SECONDS=2.5
# Skip provider calls briefly after an upstream failure and use local suggestions instead.
MEMEDROP_JOINT_SUGGESTION_COOLDOWN_MS=5000
# Used only by the explicit /suggest/caption endpoint.
MEMEDROP_CAPTION_TIMEOUT_MS=20000
MEMEDROP_USE_DRAFT_TEMPLATES=false
MEMEDROP_USE_CONTEXTUAL_CAPTION_FALLBACK=true
MEMEDROP_IMAGE_DOWNLOAD_TIMEOUT_MS=10000
MEMEDROP_MAX_IMAGE_BYTES=8388608
# Development uses local PostgreSQL/Redis and the isolated Supabase development bucket.
MEMEDROP_STORAGE_BACKEND=s3
MEMEDROP_STORAGE_BUCKET=meme-drop-dev
S3_ENDPOINT=https://your-project-ref.storage.supabase.co/storage/v1/s3
S3_REGION=your-s3-region
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Used only when MEMEDROP_STORAGE_BACKEND=local
MEME_STORAGE_PATH=./apps/api/data/memes
MEMEDROP_IMAGE_DOWNLOAD_PATH=/tmp/memedrop-downloads

# Extension
VITE_API_BASE_URL=http://localhost:3001
# Chrome Web Store builds must set VITE_API_BASE_URL to the production HTTPS API origin.
# Example: VITE_API_BASE_URL=https://api.memedrop.example
