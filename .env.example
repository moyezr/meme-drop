# Required API services
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/memedrop
# Public API origin used in durable agent-media URLs. Production must use the canonical API domain.
MEMEDROP_API_PUBLIC_ORIGIN=http://localhost:3001
OPENROUTER_API_KEY=

# Purpose-specific model choices
OPENROUTER_SUGGESTION_MODEL=google/gemini-3.7-flash
OPENROUTER_CAPTION_MODEL=google/gemini-3.7-flash
OPENROUTER_AUTO_TAG_MODEL=google/gemini-3.7-flash
OPENROUTER_TREND_MODEL=google/gemini-3.7-flash
OPENROUTER_EMBEDDING_MODEL=google/gemini-embedding-2
# Offline template-catalog tools only; the API runtime does not read this value.
OPENROUTER_TEMPLATE_MODEL=google/gemini-3.7-flash

# Offline trend collection; never called from the suggestion request path.
TAVILY_API_KEY=
MEMEDROP_TRENDS_ENABLED=false
MEMEDROP_TREND_MONTHLY_CREDIT_BUDGET=900
MEMEDROP_TREND_COLLECTION_TIMEOUT_SECONDS=8
MEMEDROP_TREND_ENRICHMENT_TIMEOUT_SECONDS=20
MEMEDROP_TREND_EMBEDDING_TIMEOUT_SECONDS=20
MEMEDROP_TREND_EMBEDDING_BATCH_SIZE=32
MEMEDROP_TREND_COLLECTION_COOLDOWN_SECONDS=1
# Required in production for retention cleanup and trend refresh. Vercel sends it as CRON_SECRET.
CRON_SECRET=
MEMEDROP_TREND_REFRESH_LOCK_TTL_SECONDS=3600
# A snapshot older than eight hours makes /health return HTTP 503 when trends are enabled.
MEMEDROP_TREND_SNAPSHOT_MAX_AGE_SECONDS=28800

# Daily generated-image retention cleanup. Claims and storage deletion are bounded per run.
MEMEDROP_GENERATED_ASSET_CLEANUP_BATCH_SIZE=100
MEMEDROP_GENERATED_ASSET_CLEANUP_CLAIM_TIMEOUT_SECONDS=900
MEMEDROP_GENERATED_ASSET_CLEANUP_LOCK_TTL_SECONDS=900
# A scheduler releases an abandoned, still-processing generation after this conservative timeout.
MEMEDROP_AGENT_GENERATION_STALE_TIMEOUT_SECONDS=1800

# Development-only bulk template annotation. Both model stages use OpenRouter.
TEMPLATE_PIPELINE_SEMANTIC_MODEL=google/gemini-3.7-flash
TEMPLATE_PIPELINE_VISION_MODEL=google/gemini-3.7-flash
TEMPLATE_PIPELINE_BATCH_SIZE=5
TEMPLATE_PIPELINE_CONCURRENCY=2
TEMPLATE_PIPELINE_COOLDOWN_MS=15000
TEMPLATE_PIPELINE_SCRAPE_DELAY_MS=1000

# Match the Redis service in docker-compose.yml.
MEMEDROP_RATE_LIMIT_STORE=redis
REDIS_URL=redis://localhost:6379/0

# Development object storage. Never put these credentials in VITE_* variables.
MEMEDROP_STORAGE_BACKEND=s3
S3_BUCKET_NAME=meme-drop-dev
S3_ENDPOINT=https://your-project-ref.storage.supabase.co/storage/v1/s3
S3_REGION=your-s3-region
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
