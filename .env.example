# Backend
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/memedrop
OPENROUTER_API_KEY=sk-or-your-openrouter-key
OPENROUTER_SITE_URL=http://localhost:3001
OPENROUTER_APP_NAME=MemeDrop
OPENROUTER_TEMPLATE_MODEL=qwen/qwen3.6-plus
MEMEDROP_CAPTION_TIMEOUT_MS=3000
MEMEDROP_USE_DRAFT_TEMPLATES=false
MEMEDROP_USE_CONTEXTUAL_CAPTION_FALLBACK=true
MEME_STORAGE_PATH=./data/memes

# Extension
VITE_API_BASE_URL=http://localhost:3001
