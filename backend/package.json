{
  "name": "@memedrop/backend",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "db:push": "drizzle-kit push",
    "db:seed": "tsx src/db/seed.ts",
    "db:seed-memes": "tsx src/db/seed-memes.ts",
    "db:init": "tsx src/db/setup.ts && drizzle-kit push && tsx src/db/seed.ts",
    "db:studio": "drizzle-kit studio",
    "manifest:generate": "tsx scripts/generate-template-manifest.ts --out shared/src/data/meme-template-manifest.generated.json",
    "manifest:dry-run": "tsx scripts/generate-template-manifest.ts --dry-run --files-only --out /tmp/memedrop-template-manifest-dry-run.json",
    "manifest:qa": "tsx scripts/render-template-qa.ts",
    "eval:suggestions": "tsx scripts/evaluate-suggestions.ts"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.50",
    "@fastify/cors": "^11.0.0",
    "@fastify/static": "^8.1.0",
    "ai": "^6.0.145",
    "dotenv": "^16.4.0",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.2.0",
    "pg": "^8.20.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.20.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
