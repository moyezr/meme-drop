{
  "name": "@memedrop/backend",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "npm run build --workspace=@memedrop/shared && tsc",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "db:push": "drizzle-kit push",
    "db:seed": "tsx src/db/seed.ts",
    "db:seed-memes": "tsx src/db/seed-memes.ts",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:init": "tsx src/db/setup.ts && drizzle-kit push && npm run db:migrate && tsx src/db/seed.ts",
    "db:studio": "drizzle-kit studio",
    "manifest:generate": "tsx scripts/generate-template-manifest.ts --out shared/src/data/meme-template-manifest.generated.json",
    "manifest:dry-run": "tsx scripts/generate-template-manifest.ts --dry-run --files-only --out /tmp/memedrop-template-manifest-dry-run.json",
    "manifest:qa": "tsx scripts/render-template-qa.ts",
    "manifest:taste-review": "tsx scripts/render-taste-review.ts",
    "manifest:audit": "tsx scripts/audit-template-annotations.ts",
    "manifest:audit:all": "tsx scripts/audit-template-annotations.ts --scope all",
    "manifest:fix-examples": "tsx scripts/fix-template-example-lengths.ts",
    "manifest:review-queue": "tsx scripts/template-review-queue.ts",
    "manifest:review-gate": "tsx scripts/template-review-queue.ts --limit 20 --fail-on-items",
    "manifest:expansion-report": "tsx scripts/template-expansion-report.ts",
    "manifest:coverage-gate": "tsx scripts/template-expansion-report.ts --fail-on-gaps --limit 0",
    "manifest:review-decisions": "tsx scripts/validate-template-review-decisions.ts",
    "manifest:review-decisions:init": "tsx scripts/init-template-review-decisions.ts",
    "manifest:promotion-plan": "tsx scripts/plan-template-promotion.ts",
    "manifest:benchmark-stubs": "tsx scripts/export-benchmark-stubs.ts",
    "eval:benchmark-import": "tsx scripts/import-benchmark-cases.ts",
    "manifest:review-decisions:promotion": "tsx scripts/validate-template-review-decisions.ts --require-benchmark-present --fail-on-missing",
    "manifest:promote-reviewed": "tsx scripts/promote-template-decisions.ts",
    "validate:production-env": "tsx scripts/validate-production-env.ts",
    "manifest:qa:queue": "tsx scripts/render-template-qa.ts --scope queue --limit 12",
    "manifest:qa:expansion": "tsx scripts/render-template-qa.ts --scope expansion",
    "manifest:qa:all": "tsx scripts/render-template-qa.ts --scope all",
    "eval:benchmark-audit": "tsx scripts/validate-suggestion-benchmark.ts",
    "eval:usage-feedback": "tsx scripts/usage-feedback-report.ts",
    "eval:suggestions": "tsx scripts/evaluate-suggestions.ts",
    "eval:quality": "tsx scripts/evaluate-suggestions.ts --limit 5 --min-top3 0.55 --min-top5 0.75 --min-caption 0.7 --min-layout 0.9 --min-overlay 0.8 --min-rejected-avoid 0.9"
  },
  "dependencies": {
    "@memedrop/shared": "0.0.1",
    "@ai-sdk/openai": "^3.0.50",
    "@fastify/cors": "^11.0.0",
    "@fastify/static": "^9.1.3",
    "ai": "^6.0.145",
    "dotenv": "^16.4.0",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.8.5",
    "pg": "^8.20.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.20.0",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
