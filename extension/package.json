{
  "name": "@memedrop/extension",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite build --watch",
    "build": "tsc && vite build",
    "validate:release-metadata": "node scripts/validate-release-metadata.mjs",
    "validate:release-package": "node scripts/validate-release-package.mjs",
    "validate:store-readiness": "node scripts/validate-store-readiness.mjs --file extension/store-listing.example.json",
    "init:store-listing": "node scripts/init-store-listing.mjs",
    "build:release": "npm run validate:release-metadata && node scripts/validate-release-build.mjs --pre && tsc && vite build && node scripts/validate-release-build.mjs --post && npm run validate:release-metadata",
    "package:release": "node scripts/package-release.mjs",
    "test": "node --import tsx --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.0.0-beta.30",
    "@types/chrome": "^0.0.304",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.4.0",
    "autoprefixer": "^10.4.0",
    "postcss": "^8.5.0",
    "tailwindcss": "^3.4.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^5.4.0"
  }
}
