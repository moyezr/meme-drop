# Copy to .env.production and replace every placeholder before deploying.
# This file documents the required shape only; do not use these values as-is.

# Database
POSTGRES_USER=memedrop
POSTGRES_PASSWORD=change-me-long-random-password
POSTGRES_DB=memedrop
DATABASE_URL=postgresql://memedrop:change-me-long-random-password@db:5432/memedrop

# Backend
MEMEDROP_ENV=production
PORT=3001
OPENROUTER_API_KEY=change-me-openrouter-api-key
OPENROUTER_SITE_URL=https://api.your-domain.com
OPENROUTER_APP_NAME=MemeDrop
MEMEDROP_CORS_ORIGINS=chrome-extension://your-published-extension-id
MEMEDROP_RATE_LIMIT_WINDOW_MS=60000
MEMEDROP_RATE_LIMIT_MAX=600
MEMEDROP_EXPENSIVE_RATE_LIMIT_WINDOW_MS=60000
MEMEDROP_EXPENSIVE_RATE_LIMIT_MAX=180
MEMEDROP_RATE_LIMIT_STORE=database
MEMEDROP_REQUIRE_INSTALL_ID=true
MEMEDROP_CAPTION_TIMEOUT_MS=3000
MEMEDROP_USE_DRAFT_TEMPLATES=false
MEMEDROP_USE_CONTEXTUAL_CAPTION_FALLBACK=true
MEMEDROP_LOG_LEVEL=info
MEMEDROP_SUGGESTION_LOGS=compact
MEMEDROP_SUGGESTION_LOG_TEXT=redacted
MEMEDROP_IMAGE_DOWNLOAD_TIMEOUT_MS=10000
MEMEDROP_MAX_IMAGE_BYTES=8388608
MEMEDROP_STORAGE_BACKEND=s3
MEMEDROP_STORAGE_BUCKET=meme-drop-prod
S3_ENDPOINT=https://your-project-ref.storage.supabase.co/storage/v1/s3
S3_REGION=your-s3-region
S3_ACCESS_KEY_ID=change-me-s3-access-key
S3_SECRET_ACCESS_KEY=change-me-s3-secret-key
MEMEDROP_IMAGE_DOWNLOAD_PATH=/tmp/memedrop-downloads

# Extension release build
VITE_API_BASE_URL=https://api.your-domain.com
